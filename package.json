{
  "name": "chatgpt-codex-bridge",
  "version": "0.1.6",
  "private": true,
  "description": "A minimal structured collaboration bridge to Chat inside the Codex desktop app.",
  "type": "module",
  "workspaces": ["packages/renderer-plugin"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "npm run build --workspace @bridge/renderer-plugin",
    "package": "tsx tools/package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "happy-dom": "20.14.0",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
